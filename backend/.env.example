# --- REST API -------------------------------------------------------------
API_PORT=4000
CORS_ORIGIN=http://localhost:5173

# --- Mock supplier APIs ---------------------------------------------------
SUPPLIER_PORT=4001
SUPPLIER_BASE_URL=http://localhost:4001

# --- Temporal -------------------------------------------------------------
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=hotel-search

# --- Orchestration tuning -------------------------------------------------
# Total budget per supplier, retries included. Exceeding it cancels that
# supplier's activity and the search proceeds with whatever else came back.
SUPPLIER_DEADLINE_MS=5000
# Per-attempt activity timeout.
SUPPLIER_ATTEMPT_TIMEOUT_MS=5000
# Retry attempts per supplier activity (1 = no retries).
SUPPLIER_MAX_ATTEMPTS=3
