{
  "name": "hotel-rate-comparator-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Temporal-orchestrated hotel rate comparator — REST API, workflow worker and mock supplier APIs.",
  "engines": { "node": ">=18.0.0" },
  "scripts": {
    "temporal:install": "bash scripts/install-temporal.sh",
    "temporal:dev": "bash scripts/temporal-dev.sh",
    "dev": "concurrently -n suppliers,worker,api -c magenta,cyan,green \"npm:dev:suppliers\" \"npm:dev:worker\" \"npm:dev:api\"",
    "dev:api": "tsx watch src/api/server.ts",
    "dev:worker": "tsx watch src/temporal/worker.ts",
    "dev:suppliers": "tsx watch src/suppliers/server.ts",
    "start:api": "tsx src/api/server.ts",
    "start:worker": "tsx src/temporal/worker.ts",
    "start:suppliers": "tsx src/suppliers/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand --selectProjects unit",
    "test:workflow": "jest --runInBand --selectProjects workflow",
    "test:watch": "jest --runInBand --watch"
  },
  "dependencies": {
    "@temporalio/activity": "^1.23.0",
    "@temporalio/client": "^1.23.0",
    "@temporalio/common": "^1.23.0",
    "@temporalio/worker": "^1.23.0",
    "@temporalio/workflow": "^1.23.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@temporalio/testing": "^1.23.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "@types/supertest": "^6.0.2",
    "concurrently": "^9.1.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
